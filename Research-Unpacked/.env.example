# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Optional. Raises NCBI E-utilities rate limits from 3 req/s to 10 req/s.
# https://www.ncbi.nlm.nih.gov/account/settings/ (API Key Management)
NCBI_API_KEY=

# Optional. Identifies this tool to Crossref for their "polite pool"
# (higher priority, more stable service). Any contact email works.
CROSSREF_MAILTO=
